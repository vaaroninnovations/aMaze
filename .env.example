# Browser build-time configuration
VITE_CONVEX_URL=https://your-deployment.convex.cloud
VITE_TRACKING_API_URL=http://localhost:8080

# Convex Auth / Google OAuth. Set the secrets in the Convex deployment environment,
# not in this file. CONVEX_SITE_URL is also required by the tracking API to verify
# Convex Auth JWTs.
CONVEX_SITE_URL=https://your-deployment.convex.site
# Local development web origin; use https://app.example.com in production.
TRACKING_ALLOWED_ORIGINS=http://localhost:5173

# Set these in the Convex deployment environment, not in the browser build.
# Google OAuth callback URI:
# https://<deployment>.convex.site/api/auth/callback/google
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# SITE_URL=https://app.example.com
# JWT_PRIVATE_KEY=
# JWKS=
# Password reset email delivery (configure in Convex, not in this file):
# RESEND_API_KEY=
# AUTH_EMAIL_FROM=aMaze <no-reply@example.com>

# Tracking service runtime configuration
TRACKING_DATA_DIR=./.tracking-data
TRACKING_MAX_UPLOAD_BYTES=1073741824
TRACKING_MAX_DURATION_SECONDS=7200
TRACKING_MAX_CONCURRENT_JOBS_PER_USER=1
TRACKING_MAX_CONCURRENT_JOBS=2
TRACKING_MAX_ACTIVE_SESSIONS=20
