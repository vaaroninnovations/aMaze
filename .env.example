# ==============================================================================
# aMaze Behavioral Neuroscience Suite - Environment Configuration
# ==============================================================================
# For Hostinger VPS: Copy this file to .env and replace placeholders with your values.
# Command: cp .env.example .env
# ==============================================================================

# Server Network Configuration
PORT=3000
HOST=0.0.0.0
# NODE_ENV is automatically set by the server or ecosystem.config.cjs

# Public Base URL of your Hostinger VPS or Custom Domain
# Examples:
#   http://123.456.78.90:3000
#   https://amaze.yourdomain.com
BASE_URL=http://localhost:3000

# Security Session Secret
# Generate a random 64-char string: openssl rand -hex 32
SESSION_SECRET=amaze_neuroscience_production_session_secret_change_me_before_deploy

# Data & Uploads Directory (stored persistently on the VPS)
DATA_DIR=./data

# ==============================================================================
# 1. GOOGLE OAUTH 2.0 CONFIGURATION
# ==============================================================================
# How to get Google Credentials:
# 1. Go to Google Cloud Console: https://console.cloud.google.com/
# 2. Create a new project or select an existing one.
# 3. Navigate to "APIs & Services" > "Credentials".
# 4. Click "+ CREATE CREDENTIALS" > "OAuth client ID".
# 5. Application type: "Web application".
# 6. Name: "aMaze Behavioral Suite".
# 7. Authorized JavaScript origins: Add your domain/IP (e.g. https://amaze.yourdomain.com or http://YOUR_VPS_IP:3000)
# 8. Authorized redirect URIs: Add your callback URL:
#    https://amaze.yourdomain.com/api/auth/google/callback
#    (or http://YOUR_VPS_IP:3000/api/auth/google/callback for testing)
# 9. Copy Client ID and Client Secret below:
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# ==============================================================================
# 2. ORCID OAUTH 2.0 CONFIGURATION (Open Researcher and Contributor ID)
# ==============================================================================
# How to get ORCID Credentials:
# 1. Go to ORCID Developer Tools:
#    Production: https://orcid.org/developer-tools
#    Sandbox (testing): https://sandbox.orcid.org/developer-tools
# 2. Register your application name: "aMaze Neuroscience Suite".
# 3. Enter your Website URL (e.g. https://amaze.yourdomain.com).
# 4. Redirect URI:
#    https://amaze.yourdomain.com/api/auth/orcid/callback
#    (or http://YOUR_VPS_IP:3000/api/auth/orcid/callback for testing)
# 5. Set ORCID_USE_SANDBOX to false for production, or true for sandbox.
# 6. Copy Client ID and Client Secret below:
ORCID_CLIENT_ID=APP-XXXXXXXXXXXXXXXX
ORCID_CLIENT_SECRET=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
ORCID_USE_SANDBOX=false
ORCID_CALLBACK_URL=http://localhost:3000/api/auth/orcid/callback
